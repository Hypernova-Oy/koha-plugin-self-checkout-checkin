[% INCLUDE 'doc-head-open.inc' %]
 <title>Koha: Self Checkout & Check-in: Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs"><a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a> &rsaquo; Self Checkout & Check-in &rsaquo; Configuration</div>

<div id="doc3">
    <h3>Koha: Self Checkout & Check-in: Configuration</h3>

    <p>OPAC URL to access this plugin: <a href="[% plugin_opac_url %]">[% plugin_opac_url %]</a></p>

    <form method="get">
        <input type="hidden" name="class" value="[% CLASS %]"/>
        <input type="hidden" name="method" value="[% METHOD %]"/>

        <h4>Self check-out (SCO)</h4>
        <p>
            [% IF diagnostics.sco.ready %]
                <span style="color: green; font-weight: bold;">Ready</span>
            [% ELSE %]
                <span style="color: red; font-weight: bold;">Not ready</span>
            [% END %]
            &mdash; <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&amp;method=[% METHOD %]">Re-run tests</a>
        </p>

        <table>
            <tr><th>System preference</th><th>Value</th><th>Status</th><th></th></tr>
            [% FOREACH p IN diagnostics.sco.sysprefs %]
            <tr>
                <td title="[% p.hint %]">[% p.name %]</td>
                <td>[% p.display %]</td>
                <td>[% IF p.ok %]<span style="color: green;">OK</span>[% ELSE %]<span style="color: red;">Check</span>[% END %]</td>
                <td><a href="[% p.url %]" target="_blank">Edit</a></td>
            </tr>
            [% END %]
        </table>

        <ul>
            <li>Credentials:
                [% IF diagnostics.sco.tests.credentials.ok %]
                    <span style="color: green;">[% diagnostics.sco.tests.credentials.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sco.tests.credentials.message %]</span>
                [% END %]
            </li>
            <li>Permissions:
                [% IF diagnostics.sco.tests.permissions.ok %]
                    <span style="color: green;">[% diagnostics.sco.tests.permissions.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sco.tests.permissions.message %]</span>
                [% END %]
            </li>
            <li>IP:
                [% IF diagnostics.sco.tests.ip.ok %]
                    <span style="color: green;">[% diagnostics.sco.tests.ip.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sco.tests.ip.message %]</span>
                [% END %]
            </li>
        </ul>

        <h4>Self check-in (SCI)</h4>
        <p>
            [% IF diagnostics.sci.ready %]
                <span style="color: green; font-weight: bold;">Ready</span>
            [% ELSE %]
                <span style="color: red; font-weight: bold;">Not ready</span>
            [% END %]
            &mdash; <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&amp;method=[% METHOD %]">Re-run tests</a>
        </p>

        <table>
            <tr><th>System preference</th><th>Value</th><th>Status</th><th></th></tr>
            [% FOREACH p IN diagnostics.sci.sysprefs %]
            <tr>
                <td title="[% p.hint %]">[% p.name %]</td>
                <td>[% p.display %]</td>
                <td>[% IF p.ok %]<span style="color: green;">OK</span>[% ELSE %]<span style="color: red;">Check</span>[% END %]</td>
                <td><a href="[% p.url %]" target="_blank">Edit</a></td>
            </tr>
            [% END %]
        </table>

        <p>
        <label for="scc_sci_username">Self check-in username or cardnumber: </label>
        <input name="scc_sci_username" value="[% scc_sci_username %]" type="text" />
        </p>
        <p>
        <label for="scc_sci_password">Self check-in password: </label>
        <input name="scc_sci_password" value="[% IF scc_sci_password_set %]********[% END %]" type="password" autocomplete="new-password" />
        </p>
        <p>
        <label for="ipallowed">IP addresses allowed (leave blank if not used): </label>
        <input name="ipallowed" value="[% ipallowed %]" />
        </p>

        <ul>
            <li>Credentials:
                [% IF diagnostics.sci.tests.credentials.ok %]
                    <span style="color: green;">[% diagnostics.sci.tests.credentials.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sci.tests.credentials.message %]</span>
                [% END %]
            </li>
            <li>Permissions:
                [% IF diagnostics.sci.tests.permissions.ok %]
                    <span style="color: green;">[% diagnostics.sci.tests.permissions.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sci.tests.permissions.message %]</span>
                [% END %]
            </li>
            <li>IP:
                [% IF diagnostics.sci.tests.ip.ok %]
                    <span style="color: green;">[% diagnostics.sci.tests.ip.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sci.tests.ip.message %]</span>
                [% END %]
            </li>
        </ul>

        <p>
        <label for="enable_virtual_keyboard">
            <input name="enable_virtual_keyboard" value="1" type="checkbox" [% IF enable_virtual_keyboard %]checked="checked"[% END %] />
            Enable virtual keyboard (KioskBoard)
        </label>
        </p>

        [% IF ( enable_virtual_keyboard ) %]
        <p>
        <label>Test KioskBoard virtual keyboard:</label><br />
        <input type="text" class="js-kioskboard-input" data-kioskboard-type="numpad" data-kioskboard-placement="bottom" id="kioskboard_test_input" value="" placeholder="Click here to test the virtual keyboard" />
        <script src="[% kioskboard_url %]"></script>
        <script>
        // Initialize KioskBoard for test input
        if (typeof KioskBoard !== 'undefined') {
            KioskBoard.init({keysArrayOfObjects: [{"0":"0","1":"1"}]});
            KioskBoard.run(document.getElementById('kioskboard_test_input'));
        }
        </script>
        </p>
        [% END %]

        <p>
        <input type="hidden" name="save" value="1" />
        <input type="submit" value="Save configuration" />
        </p>
    </form>

[% INCLUDE 'intranet-bottom.inc' %]

