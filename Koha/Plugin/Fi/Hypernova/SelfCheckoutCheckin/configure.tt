[% INCLUDE 'doc-head-open.inc' %]
 <title>Koha: Self Checkout & Check-in: Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs"><a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a> &rsaquo; Self Checkout & Check-in &rsaquo; Configuration</div>

<div id="doc3">
    <h3>Koha: Self Checkout & Check-in: Configuration</h3>

    <p>OPAC URL to access this plugin: <a href="[% plugin_opac_url %]">[% plugin_opac_url %]</a></p>

    <form method="get">
        <input type="hidden" name="class" value="[% CLASS %]"/>
        <input type="hidden" name="method" value="[% METHOD %]"/>

        <h4>Self check-out (SCO)</h4>
        <p>
            [% IF diagnostics.sco.ready %]
                <span style="color: green; font-weight: bold;">Ready</span>
            [% ELSE %]
                <span style="color: red; font-weight: bold;">Not ready</span>
            [% END %]
            &mdash; <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&amp;method=[% METHOD %]">Re-run tests</a>
        </p>

        <table>
            <tr><th>System preference</th><th>Value</th><th>Status</th><th></th></tr>
            [% FOREACH p IN diagnostics.sco.sysprefs %]
            <tr>
                <td title="[% p.hint %]">[% p.name %]</td>
                <td>[% p.display %]</td>
                <td>[% IF p.ok %]<span style="color: green;">OK</span>[% ELSE %]<span style="color: red;">Check</span>[% END %]</td>
                <td><a href="[% p.url %]" target="_blank">Edit</a></td>
            </tr>
            [% END %]
        </table>

        <ul>
            <li>Credentials:
                [% IF diagnostics.sco.tests.credentials.ok %]
                    <span style="color: green;">[% diagnostics.sco.tests.credentials.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sco.tests.credentials.message %]</span>
                [% END %]
            </li>
            <li>Permissions:
                [% IF diagnostics.sco.tests.permissions.ok %]
                    <span style="color: green;">[% diagnostics.sco.tests.permissions.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sco.tests.permissions.message %]</span>
                [% END %]
            </li>
            <li>IP:
                [% IF diagnostics.sco.tests.ip.ok %]
                    <span style="color: green;">[% diagnostics.sco.tests.ip.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sco.tests.ip.message %]</span>
                [% END %]
            </li>
        </ul>

        <h4>Self check-in (SCI)</h4>
        <p>
            [% IF diagnostics.sci.ready %]
                <span style="color: green; font-weight: bold;">Ready</span>
            [% ELSE %]
                <span style="color: red; font-weight: bold;">Not ready</span>
            [% END %]
            &mdash; <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&amp;method=[% METHOD %]">Re-run tests</a>
        </p>

        <table>
            <tr><th>System preference</th><th>Value</th><th>Status</th><th></th></tr>
            [% FOREACH p IN diagnostics.sci.sysprefs %]
            <tr>
                <td title="[% p.hint %]">[% p.name %]</td>
                <td>[% p.display %]</td>
                <td>[% IF p.ok %]<span style="color: green;">OK</span>[% ELSE %]<span style="color: red;">Check</span>[% END %]</td>
                <td><a href="[% p.url %]" target="_blank">Edit</a></td>
            </tr>
            [% END %]
        </table>

        <p>
        <label for="scc_sci_username">Self check-in username or cardnumber: </label>
        <input name="scc_sci_username" value="[% scc_sci_username %]" type="text" />
        </p>
        <p>
        <label for="scc_sci_password">Self check-in password: </label>
        <input name="scc_sci_password" value="[% IF scc_sci_password_set %]********[% END %]" type="password" autocomplete="new-password" />
        </p>
        <p>
        <label for="ipallowed">IP addresses allowed (leave blank if not used): </label>
        <input name="ipallowed" value="[% ipallowed %]" />
        </p>

        <ul>
            <li>Credentials:
                [% IF diagnostics.sci.tests.credentials.ok %]
                    <span style="color: green;">[% diagnostics.sci.tests.credentials.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sci.tests.credentials.message %]</span>
                [% END %]
            </li>
            <li>Permissions:
                [% IF diagnostics.sci.tests.permissions.ok %]
                    <span style="color: green;">[% diagnostics.sci.tests.permissions.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sci.tests.permissions.message %]</span>
                [% END %]
            </li>
            <li>IP:
                [% IF diagnostics.sci.tests.ip.ok %]
                    <span style="color: green;">[% diagnostics.sci.tests.ip.message %]</span>
                [% ELSE %]
                    <span style="color: red;">[% diagnostics.sci.tests.ip.message %]</span>
                [% END %]
            </li>
        </ul>

        <p>
        <label for="enable_virtual_keyboard">
            <input name="enable_virtual_keyboard" value="1" type="checkbox" id="enable_virtual_keyboard" [% IF enable_virtual_keyboard %]checked="checked"[% END %] />
            Enable virtual keyboard (KioskBoard)
        </label>
        </p>

        <div id="kioskboard_config" [% IF !enable_virtual_keyboard %]style="display:none"[% END %]>
        <p>
        <label for="kioskboard_theme">Keyboard theme: </label>
        <select name="kioskboard_theme">
            [% FOREACH t IN ['light','dark','flat','material','oldschool'] %]
            <option value="[% t %]" [% IF kioskboard_theme == t %]selected="selected"[% END %]>[% t %]</option>
            [% END %]
        </select>
        </p>

        <p>
        <label for="kioskboard_layout">Keyboard layout: </label>
        <select name="kioskboard_layout">
            [% FOREACH l IN ['all','keyboard','numpad'] %]
            <option value="[% l %]" [% IF kioskboard_layout == l %]selected="selected"[% END %]>[% l %]</option>
            [% END %]
        </select>
        </p>

        <p>
        <label for="kioskboard_keys_json">Custom keys (JSON, optional): </label>
        <textarea name="kioskboard_keys_json" rows="4" cols="60">[% kioskboard_keys_json %]</textarea>
        <br /><small>Overrides the layout's letter/number rows. Format: [{"0":"A","1":"B"}, ...]. Pressing Enter submits the form.</small>
        </p>

        <p>Action keys shown on the keyboard:</p>
        <ul>
            <li><label><input type="checkbox" name="kioskboard_key_space" value="1" [% IF kioskboard_key_space %]checked="checked"[% END %] /> Space</label></li>
            <li><label><input type="checkbox" name="kioskboard_key_caps" value="1" [% IF kioskboard_key_caps %]checked="checked"[% END %] /> Shift / Caps Lock</label></li>
            <li><label><input type="checkbox" name="kioskboard_key_backspace" value="1" [% IF kioskboard_key_backspace %]checked="checked"[% END %] /> Backspace</label></li>
            <li><label><input type="checkbox" name="kioskboard_key_enter" value="1" [% IF kioskboard_key_enter %]checked="checked"[% END %] /> Enter (enlarged)</label></li>
        </ul>

        <p>Enable the keyboard on these fields:</p>
        <ul>
            <li><label><input type="checkbox" name="kioskboard_field_patronid" value="1" [% IF kioskboard_field_patronid %]checked="checked"[% END %] /> SCO patron ID / barcode</label></li>
            <li><label><input type="checkbox" name="kioskboard_field_patronlogin" value="1" [% IF kioskboard_field_patronlogin %]checked="checked"[% END %] /> SCO username</label></li>
            <li><label><input type="checkbox" name="kioskboard_field_patronpw" value="1" [% IF kioskboard_field_patronpw %]checked="checked"[% END %] /> SCO password / PIN</label></li>
            <li><label><input type="checkbox" name="kioskboard_field_barcode" value="1" [% IF kioskboard_field_barcode %]checked="checked"[% END %] /> SCI check-in barcode</label></li>
        </ul>

        <p>
        <label>Test KioskBoard virtual keyboard:</label><br />
        <input type="text" class="js-kioskboard-input" data-kioskboard-type="[% kioskboard_layout %]" data-kioskboard-placement="bottom" id="kioskboard_test_input" value="" placeholder="Click here to test the virtual keyboard" />
        <style id="kioskboard_preview_style">
        [% IF !kioskboard_key_space %]#KioskBoard-VirtualKeyboard .kioskboard-key-space { display: none !important; }[% END %]
        [% IF !kioskboard_key_caps %]#KioskBoard-VirtualKeyboard .kioskboard-key-capslock { display: none !important; }[% END %]
        [% IF !kioskboard_key_backspace %]#KioskBoard-VirtualKeyboard .kioskboard-key-backspace { display: none !important; }[% END %]
        [% IF kioskboard_key_enter %]#KioskBoard-VirtualKeyboard .kioskboard-key-enter { flex-grow: 2 !important; }[% END %]
        </style>
        <script src="[% kioskboard_url %]"></script>
        <script>
        var kioskboardDefaultKeys = [% kioskboard_default_keys %];

        function kioskboardPreviewCss() {
            var rules = [];
            if (!document.querySelector('input[name="kioskboard_key_space"]').checked) {
                rules.push('#KioskBoard-VirtualKeyboard .kioskboard-key-space { display: none !important; }');
            }
            if (!document.querySelector('input[name="kioskboard_key_caps"]').checked) {
                rules.push('#KioskBoard-VirtualKeyboard .kioskboard-key-capslock { display: none !important; }');
            }
            if (!document.querySelector('input[name="kioskboard_key_backspace"]').checked) {
                rules.push('#KioskBoard-VirtualKeyboard .kioskboard-key-backspace { display: none !important; }');
            }
            if (document.querySelector('input[name="kioskboard_key_enter"]').checked) {
                rules.push('#KioskBoard-VirtualKeyboard .kioskboard-key-enter { flex-grow: 2 !important; }');
            }
            return rules.join(' ');
        }

        function kioskboardPreviewKeys() {
            var raw = document.querySelector('textarea[name="kioskboard_keys_json"]').value.trim();
            if (raw) {
                try {
                    raw = raw.replace(/\r\n?/g, '\n').replace(/,\s*([\]}])/g, '$1');
                    var parsed = JSON.parse(raw);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        return parsed;
                    }
                } catch (e) { /* invalid JSON: fall back to the defaults */ }
            }
            return kioskboardDefaultKeys;
        }

        function kioskboardRefreshPreview() {
            if (typeof KioskBoard === 'undefined') return;

            var layout = document.querySelector('select[name="kioskboard_layout"]').value;
            var theme  = document.querySelector('select[name="kioskboard_theme"]').value;

            document.getElementById('kioskboard_preview_style').textContent = kioskboardPreviewCss();

            // Replace the test input with a fresh element so KioskBoard does not
            // stack focus listeners on every configuration change.
            var oldInput = document.getElementById('kioskboard_test_input');
            var newInput = oldInput.cloneNode(false);
            newInput.value = '';
            newInput.removeAttribute('readonly');
            oldInput.parentNode.replaceChild(newInput, oldInput);
            newInput.setAttribute('data-kioskboard-type', layout);
            newInput.setAttribute('data-kioskboard-placement', 'bottom');

            KioskBoard.init({
                theme: theme,
                keysArrayOfObjects: kioskboardPreviewKeys()
            });
            KioskBoard.run(newInput);
        }

        // Toggle the KioskBoard configuration section without submitting the form.
        document.getElementById('enable_virtual_keyboard').addEventListener('change', function () {
            document.getElementById('kioskboard_config').style.display = this.checked ? '' : 'none';
        });

        // Reload the test keyboard preview whenever a configuration changes.
        ['kioskboard_theme', 'kioskboard_layout'].forEach(function (name) {
            document.querySelector('select[name="' + name + '"]').addEventListener('change', kioskboardRefreshPreview);
        });
        document.querySelector('textarea[name="kioskboard_keys_json"]').addEventListener('input', kioskboardRefreshPreview);
        ['kioskboard_key_space', 'kioskboard_key_caps', 'kioskboard_key_backspace', 'kioskboard_key_enter'].forEach(function (name) {
            document.querySelector('input[name="' + name + '"]').addEventListener('change', kioskboardRefreshPreview);
        });

        // Initial render.
        kioskboardRefreshPreview();
        </script>
        </p>
        </div>

        <p>
        <input type="hidden" name="save" value="1" />
        <input type="submit" value="Save configuration" />
        </p>
    </form>

[% INCLUDE 'intranet-bottom.inc' %]

